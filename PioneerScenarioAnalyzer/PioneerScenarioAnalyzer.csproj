<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsUraPlugin>true</IsUraPlugin>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2026.9.26</Version>

    <!-- URA 插件元数据：供发布 manifest 使用 -->
    <PluginInternalName>PioneerScenarioAnalyzer</PluginInternalName>
    <PluginDisplayName>解析野人杯回合信息</PluginDisplayName>
    <PluginAuthor>离披</PluginAuthor>
    <PluginDescription>解析野人杯回合信息</PluginDescription>
    <PluginRepositoryUrl>https://github.com/URA-Plugins/PioneerScenarioAnalyzer</PluginRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PioneerScenarioAnalyzerSmoke" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="i18n\Game.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Game.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="i18n\Game.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Game.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UmamusumeResponseAnalyzer" Version="*" PrivateAssets="all" />
  </ItemGroup>

</Project>
